# Ammonia price
ammonia_price = 600  # €/t

# OPEX ammonia production (M€/y) from module costing technique
opex_ammonia = np.array([113.2742, 113.2771, 113.2800, 113.2828, 113.2857])

# OPEX power production from INL adjusted to EUROS and 2025 values
opex_power = np.array([34.5, 61.71, 91.8])   # Lower, median, upper €/MWh

# Power production corresponding to steam diversion
ammonia_production = np.array([65700, 98550, 131400, 164250, 197100])  # t/y

power_production = np.array([
    2386974.7893,
    2112465.5137,
    1837899.1201,
    1564202.1186,
    1289593.2810
])  # MWh/y From thermodynamic model

cogen_split = np.array([2.38, 3.57, 4.76, 5.95, 7.14]) # (%) steam diversion from secondary reactor system
a_prod_tdp = np.array([200, 300, 400, 500, 600])

# -----------------------------
# CALCULATIONS
# -----------------------------

break_even_prices = []

for i in range(len(ammonia_production)):
    
    numerator = opex_ammonia[i]*1e6 - (ammonia_production[i] * ammonia_price) #
    denominator = power_production[i]
    
    p_be = numerator / denominator + opex_power
    # This is the formula because the ammonia OPEX is in €/y and
    # depends on the design capacity
    
    break_even_prices.append(p_be)

plt.figure(figsize=(7,5))
plt.plot(a_prod_tdp, break_even_prices, marker="o")
