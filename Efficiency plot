import matplotlib.pyplot as plt

# Data from thermodynamic model
production = [200, 300, 400, 500, 600]  # selected production capacities in tdp ammonia
electric_eff = [27.65, 24.24, 20.87, 17.38, 13.94]  # %
ammonia_eff = [4.04, 6.00, 7.93, 9.93, 11.91]  # %
cogen_eff = [31.69, 30.21, 28.79, 27.31, 25.85]  # %
heat_load = [10502.77, 15753.18, 21005.83, 26256.23, 31509.16]  # MWth in heat exchanger

# Create figure and primary axis
fig, ax1 = plt.subplots(figsize=(8, 5))

# Plot efficiencies on left y-axis
ax1.plot(production, electric_eff, marker='o', label='Electric Efficiency', color='blue')
ax1.plot(production, cogen_eff, marker='s', label='Cogen Efficiency', color='green')
ax1.set_xlabel('Ammonia Production (tdp)',fontsize=10, fontweight='bold')
ax1.set_ylabel('Efficiency (%)',fontsize=10, fontweight='bold')
ax1.set_ylim(0, 50)
ax1.grid(True)

# Create secondary axis for heat load
ax2 = ax1.twinx()
ax2.bar(production, heat_load, width=40, alpha=0.3, 
         label='Heat extraction', color='red')
ax2.set_ylabel('Thermal load (MWth)',fontsize=10, fontweight='bold')

# Combine legends
lines_1, labels_1 = ax1.get_legend_handles_labels()
lines_2, labels_2 = ax2.get_legend_handles_labels()
ax1.legend(lines_1 + lines_2, labels_1 + labels_2, loc='upper left')

plt.tight_layout()
plt.show()
